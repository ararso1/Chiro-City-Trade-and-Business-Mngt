// Chiro City Trader & Business Management - Prisma Schema
// MESOB integration-ready

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ RBAC ============
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // admin | officer | finance | trader
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rolePermissions RolePermission[]
  users       User[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. traders.create, payments.read
  name        String
  module      String?
  createdAt   DateTime @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  isActive      Boolean   @default(true)
  mesobUserId  String?   // MESOB system user reference
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  auditLogs     AuditLog[]
  inspections   Inspection[] @relation("Inspector")
  complaintsHandled Complaint[] @relation("ComplaintHandler")
  tradersCreated Trader[] @relation("TraderCreatedBy")
  tradersApproved Trader[] @relation("TraderApprovedBy")
  licensesIssued License[] @relation("LicenseIssuedBy")
}

// ============ TRADERS & BUSINESSES ============
model Trader {
  id            String    @id @default(cuid())
  userId        String?   @unique // if linked to system user (trader role)
  fullName      String
  gender        String?   // male | female | other
  dob           DateTime? // date of birth
  phone         String
  email         String
  nationalId    String?   // national ID number
  address       String?
  woreda        String?
  kebele        String?
  photoUrl      String?
  status        String    @default("draft") // draft | submitted | verified | active | suspended | closed
  createdById   String?
  createdBy     User?     @relation("TraderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById  String?
  approvedBy    User?     @relation("TraderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  mesobRef      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  businesses    Business[]
  licenses      License[]
  complaints    Complaint[]
  documents     TraderDocument[]
}

model Business {
  id            String    @id @default(cuid())
  traderId      String
  trader        Trader    @relation(fields: [traderId], references: [id], onDelete: Cascade)
  name          String    // business_name
  category      String    // sector/category
  type          String?   // business type (retail, wholesale, etc.)
  woreda        String?
  kebele        String?
  shopNo        String?   // shop number
  startDate     DateTime? // business start date
  address       String?
  tradeName     String?   // trading name
  subCategory   String?
  phone         String?
  email         String?
  tin           String?   // Tax ID
  status        String    @default("pending") // draft | pending | active | suspended | closed
  mesobRef      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  licenses      License[]
  inspections   Inspection[]
  payments      Payment[]
  documents     BusinessDocument[]
}

model License {
  id            String    @id @default(cuid())
  licenseNo     String    @unique // license_no
  traderId      String
  trader        Trader    @relation(fields: [traderId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  licenseType   String?   // e.g. annual_trading, sector_specific
  issueDate     DateTime? // set when status = issued
  expiryDate    DateTime? // set when status = issued
  status        String    @default("application") // application | review | approval | issued | renew | expired
  qrCode        String?   // URL or data for QR code
  issuedById    String?
  issuedBy      User?     @relation("LicenseIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  renewalReminderSent Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============ FINANCE & TAX ============
model TaxType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  amount      Decimal  @db.Decimal(14, 2) // fixed amount or base
  isPercent   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  payments    Payment[]
}

model Payment {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  taxTypeId     String?
  taxType       TaxType?  @relation(fields: [taxTypeId], references: [id])
  amount        Decimal   @db.Decimal(14, 2)
  currency      String    @default("ETB")
  year          Int       // fiscal year
  period        String?   // e.g. Q1, annual
  reference     String?   // receipt/bank reference
  status        String    @default("pending") // pending | paid | overdue | partial
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============ INSPECTIONS ============
model Inspection {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inspectorId  String
  inspector     User      @relation("Inspector", fields: [inspectorId], references: [id])
  scheduledAt  DateTime
  conductedAt  DateTime?
  status       String    @default("scheduled") // scheduled | conducted | cancelled | rescheduled
  result       String?   // pass | fail | conditional
  summary      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  violations   Violation[]
}

model Violation {
  id            String    @id @default(cuid())
  inspectionId  String
  inspection    Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  code          String
  description   String
  severity      String    // minor | major | critical
  resolvedAt   DateTime?
  resolution    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============ COMPLAINTS & SERVICE DELIVERY ============
model Complaint {
  id            String    @id @default(cuid())
  traderId      String?
  trader        Trader?   @relation(fields: [traderId], references: [id], onDelete: SetNull)
  submittedBy   String    // name/contact if not trader
  contactPhone  String?
  contactEmail  String?
  subject       String
  description   String
  category      String?   // service | license | tax | other
  status        String    @default("open") // open | in_progress | resolved | closed
  assignedToId  String?
  assignedTo    User?     @relation("ComplaintHandler", fields: [assignedToId], references: [id])
  resolution    String?
  resolvedAt    DateTime?
  followUpNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============ DIGITAL ARCHIVE ============
model TraderDocument {
  id          String   @id @default(cuid())
  traderId    String
  trader      Trader   @relation(fields: [traderId], references: [id], onDelete: Cascade)
  name        String
  type        String   // id_copy, photo, contract, etc.
  filePath    String
  mimeType    String?
  sizeBytes   Int?
  uploadedAt  DateTime @default(now())
}

model BusinessDocument {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  type        String
  filePath    String
  mimeType    String?
  sizeBytes   Int?
  uploadedAt  DateTime @default(now())
}

// ============ NOTIFICATIONS ============
model Notification {
  id          String   @id @default(cuid())
  userId      String?  // null = broadcast
  traderId    String?
  type        String   // tax_reminder | license_renewal | meeting | announcement | deadline
  title       String
  body        String?
  amount      Decimal? @db.Decimal(14, 2) // optional for tax reminders
  channel     String   // sms | email | in_app
  sentAt      DateTime?
  readAt      DateTime?
  metadata    Json?    // extra payload
  createdAt   DateTime @default(now())
}

// ============ AUDIT & MESOB ============
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model MesobSyncLog {
  id          String   @id @default(cuid())
  entity      String
  entityId    String
  direction   String   // push | pull
  status      String   // success | failed
  payload     Json?
  error       String?
  syncedAt    DateTime @default(now())
}

// ============ FISCAL YEAR & SYSTEM CONFIG ============
model FiscalYear {
  id           String   @id @default(cuid())
  calendarType String   // EC | GC
  label        String   // e.g. "2016" or "2016 EC"
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(false) // one can be marked current
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemConfig {
  id                 String   @id @default(cuid())
  key                String   @unique // fiscal_calendar_type | active_fiscal_year_id
  value              String   // EC | GC, or fiscal year id or empty for "all"
  updatedAt          DateTime @updatedAt
}
